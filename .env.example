# copie para .env. sem .env o app usa as apis do Render

# api java: login, propostas, respostas, notificacoes e placar
EXPO_PUBLIC_API_URL=https://voz-do-bairro-java.onrender.com/api

# api .net: bairros, comentarios e apoios
EXPO_PUBLIC_DOTNET_API_URL=https://voz-do-bairro-dotnet.onrender.com/api

# rodando local no emulador android use o ip da maquina, ex:
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8080/api
# EXPO_PUBLIC_DOTNET_API_URL=http://192.168.0.10:5000/api

# opcional (transcrição de áudio e propostas parecidas)
EXPO_PUBLIC_IA_API_URL=

# true = usa os dados de exemplo
EXPO_PUBLIC_USE_MOCK=false
