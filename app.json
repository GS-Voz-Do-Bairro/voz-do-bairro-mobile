{
  "expo": {
    "name": "Voz do Bairro",
    "slug": "voz-do-bairro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "vozdobairro",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F7FB",
      "dark": {
        "image": "./assets/splash-dark.png",
        "backgroundColor": "#0F1220"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fiap.vozdobairro",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3346D3"
      },
      "package": "com.fiap.vozdobairro",
      "versionCode": 1
    },
       "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "1669a40a-b36c-4e23-ab8a-f444f651211e"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "O Voz do Bairro usa o microfone para você gravar sua proposta por áudio."
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
